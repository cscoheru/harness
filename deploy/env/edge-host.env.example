# deploy/env/edge-host.env.example — fish-harness v1.1 M2 (T-M2-DO-1)
#
# ENV template for 5 edge hosts (east-1 / west-1 / asia-1 / eu-1 / sa-1)
# All sensitive values: env-inject only (do NOT commit real keys)
#
# M2 edge hosts (铁律):
#   - No STT (whisper.cpp 仅 newvps)
#   - No Web Push gateway (VAPID 私钥仅 newvps)
#   - VAPID_PRIVATE_KEY: NOT present here (仅 newvps.env.example 有占位符)
#   - WHISPER_MODEL_PATH: NOT present here
#
# Required env vars (must be injected at deploy time):
#   DEEPSEEK_API_KEY    — DeepSeek API key (env-inject only; never commit)
#   TAILSCALE_AUTHKEY  — Tailscale auth key for auto-login (per-host)
#
# Optional env vars (with defaults):
#   WORKER_ID          — default: edge{N}-wrapper
#   LOG_LEVEL          — default: INFO
#
# DO NOT add:
#   - VAPID_PRIVATE_KEY (Web Push 仅 newvps)
#   - WHISPER_MODEL_PATH (STT 仅 newvps)
#
# References:
#   - PRD-v1.1 §4.1: Tailscale-only (no Basic Auth)
#   - codex-audit-scope §4.5: env-inject only for API keys
#   - codex-audit-scope §4.7: VAPID private key centralized on newvps
# Co-Authored-By: Claude Code <noreply@anthropic.com>

# ── Required (must be set at deploy time) ────────────────────────────────────

# DeepSeek API key: env-inject only
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}

# Tailscale auth key (per-host key generated from Tailscale admin console)
# Generate: Tailscale console → Settings → Keys → Generate auth key
TAILSCALE_AUTHKEY=${TAILSCALE_AUTHKEY}

# ── Optional (with defaults) ───────────────────────────────────────────────────

# Worker ID (set automatically per edge region in compose file)
WORKER_ID=${WORKER_ID:-edge-placeholder-wrapper}

# Logging level
LOG_LEVEL=${LOG_LEVEL:-INFO}

# Edge region (set by EDGE_REGION env in compose; informational only)
EDGE_REGION=${EDGE_REGION:-edge-unknown}

# ── Orchestrator config ───────────────────────────────────────────────────────

# Harness kernel URL: MagicDNS name (no pinned IP; hygiene §4.5)
# In compose files, this is set per-host as HARNESS_API_URL
# Example for edge1: http://harness-newvps.tail1b9878.ts.net:8000
HARNESS_API_URL=${HARNESS_API_URL:-http://harness-newvps.tail1b9878.ts.net:8000}

# Wrapper port (fixed at 4001 on edge hosts)
WRAPPER_PORT=4001

# Orchestrator class (edge hosts use orchestrator only)
ORCHESTRATOR_CLASS=orchestrator

# dsh profile: MUST be headless (per M0b QA-1 §6.X)
DSH_PROFILE=headless

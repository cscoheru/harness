{
  "name": "fish-harness-wrapper",
  "version": "0.1.0-m0c-skeleton",
  "description": "TypeScript wrapper for fish-harness v1.0 runtime kernel — M0c skeleton",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit/",
    "test:integration": "vitest run test/integration/",
    "test:e2e:smoke": "playwright test test/e2e/pwa_dispatch.test.ts",
    "test:coverage": "vitest run --coverage",
    "build": "tsc"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^3.2.7",
    "express": "^5.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}

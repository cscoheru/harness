[Unit]
Description=fish-harness edge webhook receiver (v1.2.0e.1 NEW)
# Pull main + rebuild + reload on `v*` tag events from GitHub Actions
# notify-edge job. Bound to 127.0.0.1:7777; Tailscale Funnel exposes /webhook.
# See docs/deploy/6host-deploy.md §2.

[Service]
Type=simple
User=root
# Per-host HMAC secret (chmod 600); generated by install.sh
EnvironmentFile=/etc/edge-webhook.env
# Per-host compose file (overridden via drop-in or EnvironmentFile)
Environment=EDGE_COMPOSE_FILE=/opt/fish-harness/deploy/6host-compose.edge1.yml
ExecStart=/usr/bin/node --import tsx /opt/fish-harness/wrapper/deploy/edge-webhook/edge-pull.ts
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
# Hardening (per L8 + D6):
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/fish-harness
PrivateTmp=true

[Install]
WantedBy=multi-user.target

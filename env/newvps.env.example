# env/newvps.env.example — Environment variable template for newvps deployment
# (T-M0c-DO-1)
#
# GH013 PUSH PROTECTION lesson: DO NOT hard-code real secrets here.
# Use placeholders (${VAR}) — inject real values at deploy time via:
#   1. Host-level environment file (not committed)
#   2. docker compose --env-file pointing to host secret store
#   3. GitHub Actions secrets (for CI/CD deployments)
#
# All values below are PLACEHOLDERS. Replace before deployment.
# Validation: `grep -rE "sk-[a-z0-9]{32,}" deploy/ env/` must return 0 lines.

# ── Harness Kernel ──────────────────────────────────────────────────────────
# Internal port the harness kernel listens on (inside compose network).
HARNESS_PORT=8000

# ── Tailscale ──────────────────────────────────────────────────────────────
# Auth key for this host to join the tailnet.
# Generate at: https://login.tailscale.com/admin/settings/authkeys
# Scope: tag:harness (newvps host)
TAILSCALE_AUTHKEY=${TAILSCALE_AUTHKEY}

# Hostname in the tailnet (used for Tailscale Serve).
TAILSCALE_HOSTNAME=harness-newvps

# ── Model API ─────────────────────────────────────────────────────────────
# DEEPSEEK_API_KEY — inject via host secret, NOT hard-coded here.
# GH013: real key triggers GitHub secret scanning → push rejected.
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}

# Model for the orchestrator/commander layer.
# Not a hard constraint — SKU resolved from spec/capabilities/ at runtime.
# Placeholder until M0b capability JSON is finalized.
ORCHESTRATOR_MODEL=${ORCHESTRATOR_MODEL:-deepseek-chat}
COMMANDER_MODEL=${COMMANDER_MODEL:-deepseek-chat}

# ── Worker ─────────────────────────────────────────────────────────────────
# Unique ID for this worker instance.
# If deploying multiple workers, each needs a distinct WORKER_ID.
WORKER_ID=${WORKER_ID:-worker-001}

# Worker class — maps to spec/capabilities/worker.json (M0b产出).
# NOT a specific model SKU (NORTH-STAR A-4 equivalence class).
WORKER_CLASS=worker

# ── Harness Kernel (runtime config) ────────────────────────────────────────
# URL the kernel uses for health-check / API.
HARNESS_API_URL=http://harness-kernel:8000

# SQLite database path inside the kernel container.
HARNESS_DB_PATH=/data/harness.db

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=${LOG_LEVEL:-INFO}

# ── M0c Stage 1 notes ─────────────────────────────────────────────────────
# This file covers Stage 1 skeleton only.
# Future stages (M0c Stage 2+) will add:
#   - TAILSCALE_OAUTH_CLIENT_ID / TAILSCALE_OAUTH_CLIENT_SECRET (if using OAuth)
#   - RAG_SERVICE_URL (future: rag-service integration)
#   - SENTRY_DSN (future: error tracking)

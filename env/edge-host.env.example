# env/edge-host.env.example — environment template for fish-harness edge hosts.
#
# Edge hosts (harness-edge1..5) carry ONLY the wrapper orchestrator process.
# STT worker and Web Push gateway are newvps-only (per v1.1 §4.6-§4.7).
#
# Operator workflow (per deploy/runbook-edge-provision.md §2):
#   1. Copy this file to /etc/fish-harness/edge-host.env on each edge host
#   2. Replace each __PLACEHOLDER__ with the real value
#   3. chmod 600 /etc/fish-harness/edge-host.env  (secret hygiene)
#   4. docker compose --env-file /etc/fish-harness/edge-host.env -f deploy/6host-compose.edge<N>.yml up -d
#
# NEVER commit a real .env (real keys). This is the EXAMPLE template only.
#
# Hygiene:
#   - DEEPSEEK_API_KEY: env-inject only (no hardcoded value)
#   - VAPID_PRIVATE_KEY: env-inject only (only newvps uses this; edge hosts can leave blank)
#   - TAILSCALE_AUTHKEY: one-time pre-auth key from Tailscale admin console
#   - WORKER_ID: stable identifier for logs (e.g. edge1-wrapper)

# ─── Tailscale identity ─────────────────────────────────────────────────────
# Pre-auth key from https://login.tailscale.com/admin/settings/keys
# Reusable=true is OK for batch-provisioning 5 edge hosts.
TAILSCALE_AUTHKEY=tskey-auth-__TAILSCALE_AUTHKEY__

# ─── Cross-host routing ─────────────────────────────────────────────────────
# Tailscale MagicDNS suffix; default for this project is "tail1b9878.ts.net".
# Edge hosts use this suffix to resolve harness-newvps.<suffix>.
TAILSCALE_MAGIC_DNS_SUFFIX=tail1b9878.ts.net

# ─── DeepSeek API key (env-inject only; never hardcode) ─────────────────────
# Required: dsh CLI calls require this env var to be present.
DEEPSEEK_API_KEY=__DEEPSEEK_API_KEY__

# ─── Worker identity (stable per host) ───────────────────────────────────────
# Used by wrapper to identify itself in logs and metrics.
WORKER_ID=__WORKER_ID__-wrapper

# ─── VAPID private key (newvps only; edge hosts can leave empty) ────────────
# STT worker + Web Push gateway live on newvps; edge hosts do not need this.
# Leave blank unless you reconfigure edge to host web-push-gateway.
VAPID_PRIVATE_KEY=

# ─── Edge region (set per host) ─────────────────────────────────────────────
# Valid values: east-1, west-1, asia-1, eu-1, sa-1
# Each edge<N>.yml sets its own EDGE_REGION; this is informational only.
EDGE_REGION=__EDGE_REGION__